[Unit]
Description=Edge AI Object Detection Daemon
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
ExecStart=/usr/bin/edge-ai-manager --config /opt/jetson-ai-detect/config/app_config.yaml

# Automatic Recovery
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

# Watchdog Integration
WatchdogSec=60

# Resource Allocation & Hardening
MemoryMax=3200M
CPUQuota=350%
ProtectSystem=strict
ReadWritePaths=/var/log/jetson-ai-detect /var/lib/jetson-ai-detect /opt/jetson-ai-detect/models /dev/watchdog

# Environment for Tegra GPU Libraries
Environment=LD_LIBRARY_PATH=/usr/lib/aarch64-linux-gnu/tegra:/usr/local/cuda-10.2/lib64
Environment=CUDA_HOME=/usr/local/cuda-10.2

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=edge-ai-manager

[Install]
WantedBy=multi-user.target

